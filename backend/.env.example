# Sonnad Studio: server settings.
# Copy this file to backend/.env and fill it in. Keep .env private: never share or upload it.

# The website runs at http://localhost:PORT
PORT=3000
# Set to "production" when the site is live on https (makes sign-in cookies https-only)
NODE_ENV=development

# MongoDB Atlas connection link.
# Atlas → your cluster → Connect → Drivers → copy the link, then put your database user's password in place of <db_password>.
MONGODB_URI=mongodb+srv://<username>:<db_password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically)
MONGODB_DB=sonnad

# First admin account. Only used when the database has no admin yet.
ADMIN_EMAIL=admin@sonnad.studio
ADMIN_PASSWORD=change-this-password

# How many days people stay signed in
SESSION_DAYS=7

# Cloudinary (image storage). Cloudinary dashboard → Settings → API Keys.
# Leave empty to keep saving pictures in frontend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary Media Library
CLOUDINARY_FOLDER=sonnad-studio
